@model ArquitecturaModel.ViewModels.DevolucionViewModel

@{
    ViewData["Title"] = "Create";
}

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="FacturaId" />
    <input type="hidden" asp-for="Producto" id="prod" />
    <input type="hidden" asp-for="PrecioUnitario" id="Precioprod" />

    <div class="row">
        <div class="col-md-12">
            <!--begin::Portlet-->
            <div class="kt-portlet">
                <div class="kt-portlet__head">
                    <div class="kt-portlet__head-label">
                        <h3 class="kt-portlet__head-title">
                            Devoluciones
                        </h3>
                    </div>
                </div>

                <!--begin::Form-->
                <div class="kt-portlet__body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ClienteId" class="control-label"></label>
                                <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.ClienteId">
                                    <option value="">Seleccionar Cliente</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-md-6"><span>Total Divisa</span></div>
                                <div class="col-md-6"><span class="kt-font-brand">@Html.DisplayFor(model => model.Tasa)</span></div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-6"><span>Total</span></div>
                                <div class="col-md-6"><span id="sTotal" class="kt-font-brand">@Html.DisplayFor(model => model.Total)</span></div>
                            </div>
                        </div>
                    </div>
                    <!--end::Form-->
                </div>
                <!--end::Portlet-->
            </div>

          @*   <div class="col-md-12">
                <!--begin::Portlet-->
                <div class="kt-portlet">
                    <div class="kt-portlet__head">
                        <div class="kt-portlet__head-label">
                            <h3 class="kt-portlet__head-title">
                                Seleccionar Producto
                            </h3>
                        </div>
                    </div>
                    <!--begin::Form-->
                    <div class="row">
                        <div class="col-md-6">
                            <label asp-for="ProductoId" class="control-label"></label>
                            <select asp-for="ProductoId" id="btoProducto" class="form-control" asp-items="ViewBag.ProductoId">
                                <option value="">Seleccionar Producto</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 form-group">
                            <label asp-for="Cantidad" class="control-label"></label>
                            <input asp-for="Cantidad" class="form-control txtn" />
                            <span asp-validation-for="Cantidad" class="text-danger"></span>
                        </div>
                        <div class="col-md-2 form-group">
                            <label asp-for="PrecioUnitario" class="control-label"></label>
                            <input asp-for="PrecioUnitario" class="form-control" disabled />
                        </div>
                        <br />
                        <div class="col-md-3">
                            <div class="form-group">
                                <label style="color:white">k</label>
                                <div>
                                    <button class="btn btn-primary" type="submit" value="addproducto" name="action">
                                        <i class="glyphicon glyphicon-plus">Agregar</i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!--end::Form-->
                </div>
                <!--end::Portlet-->
            </div> *@
            <div class="col-md-12">
                <!--begin::Portlet-->
                <div class="kt-portlet">
                    <div class="kt-portlet__head">
                        <div class="kt-portlet__head-label">
                            <h3 class="kt-portlet__head-title">
                                Detalle de la Facturación
                            </h3>
                        </div>
                    </div>
                    <!--begin::Form-->
                    <div class="kt-portlet__body">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>
                                        Producto
                                    </th>
                                    <th>
                                        Cantidad
                                    </th>
                                    <th>
                                        Precio Unitario
                                    </th>
                                   @*  <th>
                                        SubTotal
                                    </th> *@
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DetalleDocumentoViews != null)
                                {
                                    for (var j = 0; j < Model.DetalleDocumentoViews.Count; ++j)
                                    {
                                        <input type="hidden" asp-for="@Model.DetalleDocumentoViews[j].DetalleDocumentoId" />
                                        <input type="hidden" asp-for="@Model.DetalleDocumentoViews[j].ProductoId" />
                                        <input type="hidden" asp-for="@Model.DetalleDocumentoViews[j].Producto" />
                                        <input type="hidden" asp-for="@Model.DetalleDocumentoViews[j].Cantidad" />
                                        <input type="hidden" asp-for="@Model.DetalleDocumentoViews[j].PrecioUnitario" />
                                        <input type="hidden" asp-for="@Model.DetalleDocumentoViews[j].SubTotal" />
                                        <input type="hidden" asp-for="@Model.DetalleDocumentoViews[j].IvaUnitario" />
                                        <input type="hidden" asp-for="@Model.DetalleDocumentoViews[j].Iva" />
                                        <input type="hidden" asp-for="@Model.DetalleDocumentoViews[j].TotalIva" />
                                        <input type="hidden" asp-for="@Model.DetalleDocumentoViews[j].Total" />
                                        <input type="hidden" asp-for="@Model.DetalleDocumentoViews[j].Eliminado" id="delete_@j" />

                                        @if (!Model.DetalleDocumentoViews[j].Eliminado)
                                        {
                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => Model.DetalleDocumentoViews[j].Producto)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => Model.DetalleDocumentoViews[j].Cantidad)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => Model.DetalleDocumentoViews[j].PrecioUnitario)
                                                </td>
                                               @*  <td>
                                                    @Html.DisplayFor(modelItem => Model.DetalleDocumentoViews[j].SubTotal)
                                                </td> *@
                                              @*   <td>
                                                    <button name="action" type="submit" value="Eliminar" class="btn btn-danger btn-sm" id="" onclick="confirmar(@j)">Eliminar</button>
                                                </td> *@
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <!--end::Form-->
                </div>
                <!--end::Portlet-->

            </div>
            <div class="col-md-12">
                <!--begin::Portlet-->
                <div class="kt-portlet">
                    <div class="kt-portlet__head">
                        <div class="kt-portlet__head-label">
                            <h3 class="kt-portlet__head-title">
                                Descripción de la Devolución
                            </h3>
                        </div>
                    </div>
                    <div class="kt-portlet__body">
                        <textarea asp-for="DescripcionDevolucion" class="form-control"></textarea>
                        <span asp-validation-for="DescripcionDevolucion" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="kt-portlet__foot">
                        <div class="kt-form__actions">
                            <button class="btn btn-primary" type="submit" value="Registrar Factura" name="action">
                                Registrar Devolución
                            </button>
                            <a asp-action="Create" asp-controller="Devoluciones" class="btn btn-secondary">Cancelar</a>
                            <a asp-action="Index" class="btn btn-info">Ir a la Lista</a>
                        </div>
                    </div>
                </div>
                <!--end::Portlet-->
            </div>
        </div>
    </div>

</form>


