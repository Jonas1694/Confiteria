@model ArquitecturaModel.Model.Facturacion
@{
	Layout = null;
}
<!DOCTYPE html>
<head>
	<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
	<link href="~/lib/bootstrap/dist/css/bootstrap.rtl.css" rel="stylesheet" />
	<link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
</head>
<body>
	<div class="row">
		<br />
		<div class="col-12 text-center">
			@Model.Sucursales.SucursalName.ToUpper() <br/>
			@Model.Sucursales.TipoDocumento-
			@Model.Sucursales.Rif
		</div>
		<div class="col-12 text-center" >
			@Model.Sucursales.DireccionFiscal.ToUpper()
		</div>
	</div>
	<br />
	<div class="row">
		<div class="col-12">
			<label>Fecha Emision: </label>
			@Model.FechaRegistro
		</div>
	</div>
	<div class="row">
		<div class="col-12">
			<label>Factura N°: </label>
			@Model.NFactura
		</div>
	</div>
	<div class="row">
		<div class="col-12">
			<label>Cliente: </label>
			@Model.Clientes.GetRif
		</div>
	</div>
	<div class="row">
		<div class="col-6">
			<label>Direccion: </label>
			@Model.Clientes.DireccionFiscal
		</div>
	</div>
	<hr />
	<div class="row">
		<div class="col-12">
			<table style="width:100%;">
				<thead>
					<tr>
						<th>Cantidad</th>
						<th class="text-center">Producto</th>
						<th class="text-center">Precio Und</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var i in Model.DetalleFacturas)
					{
						<tr>
							<td class="text-center">@i.Cantidad</td>
							<td class="text-center">@i.Productos.Descripcion</td>
							<td class="text-center">@i.PrecioUnitario</td>
							
						</tr>
					}
				</tbody>
				<tfoot>
					<tr>
						<td colspan="3"><hr /></td>
					</tr>
					<tr>
						<td colspan="3" class="text-end">
							<div style="margin-right:10px;">
								<label>Total Bs: </label>
								@Model.Total
							</div>
						</td>
					</tr>
					<tr>
						<td colspan="3" class="text-end">
							<div style="margin-right:10px;">
								<label>Total $: </label>
								@Model.Tasa.ToString("N2")
							</div>
						</td>
					</tr>
				</tfoot>
			</table>
		</div>
	</div>
	<br />

	@* <div class="row">
		<div class="offset-6 col-6">
			<label>Sub-Total: </label>
			@Model.SubTotal
			
		</div>
	</div>
	
	<div class="row">
		<div class="offset-6 col-6">
			<label>Iva: </label>
			@Model.TotalIva
		</div>
	</div> *@

	<br />

	<div class="col-12 text-center">
		NO SE ACEPTAN CAMBIOS DESPUES DE 2 DIAS Y SIN FACTURA
	</div>
	<div class="col-12 text-center">
	 PARTES ELECTRICAS NO TIENE DEVOLUCION
	</div>
	<div class="col-12 text-center">
		NO SE DEVUELVE DINERO
	</div>



	<br />
</body>

