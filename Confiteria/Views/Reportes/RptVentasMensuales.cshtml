@model IEnumerable<ArquitecturaModel.Model.Facturacion>

@{
	Layout = null;
}
<!DOCTYPE html>
<head>
	<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
	<link href="~/lib/bootstrap/dist/css/bootstrap.rtl.css" rel="stylesheet" />
	<link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
</head>
<body>
	@if(Model.Count() > 0)
	{
		var registro = Model.FirstOrDefault();
		var fechaRegistro = registro?.FechaRegistro;

		// Calcular la fecha de cierre como el último día del mes de la fecha de registro
		var fechaCierre = fechaRegistro.HasValue
		? new DateTime(fechaRegistro.Value.Year, fechaRegistro.Value.Month, DateTime.DaysInMonth(fechaRegistro.Value.Year, fechaRegistro.Value.Month)).ToShortDateString()
		: "Fecha no disponible";
		var fechaDesde = fechaRegistro != null ? fechaRegistro.Value.ToString("d") : "Fecha no disponible";

		<div class="container-fluid">
			<div class="row">
				<div class="col-12 text-center">
					MOTOS REPUESTOS SANTA RITA 2024 , C.A
				</div>
				<div class="col-12 text-center">
					J-504928429
					AV PRINCIPAL FRANCISCO DE MIRANDA, EDO ARAGUA
				</div>
				<div class="col-12 text-center">
					<p style="display: inline;">Fecha Desde: @fechaDesde</p>
					<p style="display: inline; margin-left: 20px;">Fecha Hasta: @fechaCierre</p>
				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<table class="table table-bordered">
						<thead>
							<tr>
								<th>N Factura</th>
								<th>Cliente</th>
								<th>Fecha</th>
								<th>Tipo Pago</th>
								<th>Total</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var i in Model)
							{
								<tr>
									<td class="text-center">@i.NFactura</td>
									<td class="text-center">@i.Clientes.RazonSocial</td>
									<td class="text-center">@i.FechaRegistro</td>
									<td class="text-center">@i.FormaPago.Name</td>
									<td class="text-end">@i.MontoCancelar.Value.ToString("N2")</td>
								</tr>
							@* 	<tr>
									<td colspan="4">
										<table class="table">
											<thead>
												<tr>
													<th>Descripcion Producto</th>
													<th>Cantidad Producto</th>
												</tr>
											</thead>
											<tbody>
												@foreach (var p in i.DetalleFacturas)
												{
													<tr>
														<td class="text-center">@p.Productos.Descripcion</td>
														<td class="text-center">@p.Cantidad</td>
													</tr>
												}
											</tbody>
										</table>
									</td>
								</tr> *@
							}
						</tbody>
						<br />
						<tfoot>
							<tr>
								<td colspan="6" class="text-end">
									<label>Monto Total Efectivo BS : </label>
									@Model.Where(s => s.FormaPago.Name == "Efectivo BS").Sum(s => s.Total).ToString("N2")
								</td>
							</tr>
							<tr>
								<td colspan="6" class="text-end">
									<label>Monto Total Divisas: </label>
									@Model.Where(s => s.FormaPago.Name == "Divisa").Sum(s => s.Tasa).ToString("N2")
								</td>
							</tr>
							<tr>
								<td colspan="6" class="text-end">
									<label>Monto Total Punto: </label>
									@Model.Where(s => s.FormaPago.Name == "Punto").Sum(s => s.Total).ToString("N2")
								</td>
							</tr>
							<tr>
								<td colspan="6" class="text-end">
									<label>Monto Total Pago Movil:</label>
									@Model.Where(s => s.FormaPago.Name == "Pago Movil").Sum(s => s.Total).ToString("N2")
								</td>
							</tr>
							<tr>
								<td colspan="6" class="text-end">
									<label>Monto Total BioPago: </label>
									@Model.Where(s => s.FormaPago.Name == "Biopago").Sum(s => s.Total).ToString("N2")
								</td>
							</tr>
							<tr>
								<td colspan="6" class="text-end">
									<label>Monto Total Mixto: </label>
									@Model.Where(s => s.FormaPago.Name == "Mixto").Sum(s => s.Total).ToString("N2")
								</td>
							</tr>
							<tr>
								<td colspan="6" class="text-end">
									<label>Monto Total en Bolivares : </label>
									@Model.Sum(s => s.Total).ToString("N2")
								</td>
							</tr>
						</tfoot>
					</table>
				</div>
			</div>
		</div>
	}
	else
	{
		<h3>No hay informacion.</h3>
	}
</body>

