@model IEnumerable<ArquitecturaModel.Model.Devolucion>

@{
    ViewData["Title"] = "Lista";
}
<link rel="stylesheet" href="https://cdn.datatables.net/1.10.19/css/jquery.dataTables.min.css" />

<!--begin::Portlet-->
<div class="kt-portlet">
	<div class="kt-portlet__head kt-portlet__head--lg">
		<div class="kt-portlet__head-label">
			<h3 class="kt-portlet__head-title">
                Lista de Devoluciones
			</h3>
		</div>
		<div>
			<div>
				<div class="col-md-12">
					<a asp-action="Create" class="btn btn-outline-info">
                        <i class="la la-plus"></i>Nueva Devolución
					</a>
				</div>
			</div>
		</div>
	</div>
	<div class="kt-portlet__body">
		<table class="table table-hover table-responsive table-striped" id="MyTable">
			<thead>
				<tr>
					<th>
						@Html.DisplayNameFor(model => model.Clientes)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.NDocumento)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.StatusDocumento)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.Total)
					</th>
                   
					<th>
						@Html.DisplayNameFor(model => model.FechaRegistro)
					</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td>
							@Html.DisplayFor(modelItem => item.Clientes.RazonSocial)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.NDocumento)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.StatusDocumento.StatusDocumento)
						</td>
						<td>
							@item.Total.ToString("C")
						</td>
						<td>
							@item.FechaRegistro.ToShortDateString()
						</td>
						<td>
							<a asp-action="Edit" asp-route-id="@item.DevolucionId" class="btn btn-outline-warning">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.DevolucionId" class="btn btn-outline-info btn-sm">Detalles</a>
							<a asp-action="Delete" asp-route-id="@item.DevolucionId" class="btn btn-outline-danger">delete</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>

@section Scripts {
	<script src="//cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"></script>

	<script type="text/javascript">
		$(document).ready(function () {
			$('#MyTable').DataTable({
				order: [[1, 'desc']],
				"language": {
					"url": "//cdn.datatables.net/plug-ins/9dcbecd42ad/i18n/Spanish.json"
				},
				"aLengthMenu": [
					[25, 50, 100, 200, -1],
					[25, 50, 100, 200, "Todos"]
				]


			});
		});
	</script>
}
