@model IEnumerable<ArquitecturaModel.ViewModels.RptGananciaViewModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<head>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
</head>
<body>
    <div class="row">
        <div class="col-12 text-center">
            FERRE ELECTRIC EXPRESS 2026, C.A
        </div>
        <div class="col-12 text-center">
            J-508863374
        AV PRINCIPAL SANTA ISABEL C/C CALLE SAN VICENTE, LOCAL 04 URB VALLE VERDE, ESTADO ARAGUA
        </div>
        <br />
        @* <div class="col-12 text-center">
            Fecha de Cierrre: @Model.FirstOrDefault()!.FechaRegistro!.ToShortDateString()
        </div> *@
    </div>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Total Venta</th>
                <th>Ganancia</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NombreProducto.ToUpper()</td>
                    <td class="text-center">@item.Cantidad</td>
                    <td class="text-end">@item.Total.ToString("n2")</td>
                    <td class="text-end">@item.Ganancia.ToString("n2")</td>
                </tr>
            }
        </tbody>
		<tfoot>
			<tr>
				<td colspan="6" class="text-end">
					<label>Monto Total de Ganancias : </label>
					@Model.Sum(s => s.Ganancia).ToString("N2")
				</td>
			</tr>
		</tfoot>
    </table>

</body>